{
  "name": "fish-design",
  "version": "0.1.0",
  "description": "FISH \u2014 Figma In a Single Html. High-performance, self-contained vector canvas in a single HTML file.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-plugin.mjs --all && vite build && node scripts/compress-shell.mjs && node scripts/build-fish-agent-kit.mjs && node scripts/build-figma-plugin.mjs && node scripts/build-chrome-extension.mjs",
    "plugin:build": "node scripts/build-plugin.mjs --all",
    "test": "vitest run",
    "test:fast": "node scripts/test-fast.mjs",
    "test:isolated": "vitest run --isolate --no-file-parallelism",
    "verify": "node scripts/verify.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "typecheck": "tsc --noEmit",
    "fish:shot": "node scripts/fish-shot.mjs",
    "render": "node scripts/headless-render.mjs",
    "figma:verify": "node scripts/verify-figma-import.mjs",
    "figma:plugin": "node scripts/build-figma-plugin.mjs",
    "html:probe": "node scripts/probe-html-import.mjs",
    "html:corpus": "node scripts/html-import-corpus.mjs",
    "html:fidelity": "node scripts/html-import-fidelity.mjs",
    "instance:probe": "node scripts/probe-instance.mjs",
    "instance:inherit": "node scripts/probe-instance-inherit.mjs",
    "probe:modify-loop": "node scripts/probe-modify-loop.mjs",
    "crop:verify": "node scripts/verify-image-crop.mjs",
    "probe:filter-region": "node scripts/probe-filter-region.mjs",
    "shot:ps": "powershell -File scripts/shot.ps1",
    "autosave:verify": "node scripts/verify-autosave.mjs",
    "repair:file": "node scripts/repair-fish-file.mjs",
    "reshell": "node scripts/reshell.mjs",
    "profile:pan": "node scripts/profile-pan.mjs",
    "update:verify": "node scripts/verify-update.mjs",
    "release:keys": "node scripts/derive-release-keys.mjs",
    "release:manifest": "node scripts/write-release-manifest.mjs",
    "release:catalog": "node scripts/build-plugin-catalog.mjs",
    "release:kit": "node scripts/pack-agent-kit.mjs",
    "release:assemble": "node scripts/assemble-site.mjs",
    "release:verify": "node scripts/verify-published.mjs",
    "sync:public": "bash scripts/sync-to-public.sh"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "polygon-clipping": "^0.15.7",
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@gfx/zopfli": "^1.0.15",
    "@preact/preset-vite": "^2.10.1",
    "@types/node": "^22.13.10",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.51.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "terser": "^5.51.2",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^3.0.8"
  }
}